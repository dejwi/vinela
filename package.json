{
  "name": "vinela",
  "private": true,
  "version": "0.2.1",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/dejwi/vinela",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dejwi/vinela.git"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "pretest": "bun run scripts/check-test-literals.ts",
    "dev": "tauri dev",
    "build": "tauri build",
    "preview": "vite preview",
    "vite:build": "vite build",
    "lint": "biome check --error-on-warnings .",
    "typecheck:app": "tsc --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck": "bun run typecheck:app && bun run typecheck:scripts",
    "updates:validate-config": "bun run scripts/validate-updater-config.ts",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "tauri": "tauri",
    "icons:generate": "tauri icon assets/branding/icon-manifest.json --output src-tauri/icons && bun -e \"await Bun.write('public/favicon.png', Bun.file('src-tauri/icons/icon.png'))\"",
    "config:generate": "bun run scripts/nvim-config-test/generate.ts",
    "config:test": "bun run scripts/nvim-config-test/nvim-runner.ts",
    "config:check": "bun run scripts/nvim-config-test/workflow.ts",
    "metadata:refresh": "bun run scripts/refresh-repository-metadata.ts",
    "version:bump": "bun run scripts/bump-version.ts",
    "schema:validator:build": "bun run scripts/build-plugin-schema-validator.ts",
    "schema:validator:check": "bun run scripts/build-plugin-schema-validator.ts --check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vercel/analytics": "^1.6.1",
    "@xyflow/react": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "immer": "^11.1.3",
    "lucide-react": "^0.563.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.2",
    "shiki": "^3.22.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.2",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^4.1.10",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "^10.5.4",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.25",
    "tailwindcss": "4",
    "typescript": "~5.8.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "picomatch": "4.0.5",
    "rollup": "4.62.4"
  }
}
