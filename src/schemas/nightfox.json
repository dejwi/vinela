{
  "id": "nightfox",
  "pluginName": "nightfox.nvim",
  "pluginRepo": "https://github.com/EdenEast/nightfox.nvim",
  "version": "1.0.0",
  "description": "Highly configurable theme suite for Neovim with seven fox variants.",
  "author": "EdenEast",
  "stars": 3500,
  "category": "ui",
  "tagline": "Seven-variant theme family tuned for readability",
  "tags": ["colorscheme", "theme", "both", "nightfox", "carbonfox", "nordfox", "#192330", "#719cd6", "#c94f6d"],
  "setup": { "requirePath": "nightfox", "setupFunction": "setup", "optionMapping": "table" },
  "options": [
    { "key": "style", "label": "Variant / Flavor", "type": "select", "group": "Appearance", "default": "carbonfox", "options": [{ "value": "nightfox", "label": "Nightfox" }, { "value": "dayfox", "label": "Dayfox" }, { "value": "dawnfox", "label": "Dawnfox" }, { "value": "duskfox", "label": "Duskfox" }, { "value": "nordfox", "label": "Nordfox" }, { "value": "terafox", "label": "Terafox" }, { "value": "carbonfox", "label": "Carbonfox" }] },
    { "key": "transparent", "label": "Transparent Background", "type": "boolean", "group": "Appearance", "default": false },
    { "key": "terminal_colors", "label": "Set Terminal Colors", "type": "boolean", "group": "Appearance", "default": true },
    { "key": "dim_inactive", "label": "Dim Inactive Windows", "type": "boolean", "group": "Appearance", "default": false },
    { "key": "module_default", "label": "Enable Modules by Default", "type": "boolean", "group": "Integrations", "default": true },
    { "key": "colorblind.enable", "label": "Enable Colorblind Simulation", "type": "boolean", "group": "Accessibility", "default": false },
    { "key": "colorblind.simulate_only", "label": "Simulation Only", "type": "boolean", "group": "Accessibility", "default": false, "visibleWhen": { "key": "colorblind.enable", "equals": true } },
    { "key": "colorblind.severity.protan", "label": "Protan Severity", "type": "number", "group": "Accessibility", "default": 0, "validation": { "min": 0, "max": 1, "step": 0.1 } },
    { "key": "colorblind.severity.deutan", "label": "Deutan Severity", "type": "number", "group": "Accessibility", "default": 0, "validation": { "min": 0, "max": 1, "step": 0.1 } },
    { "key": "colorblind.severity.tritan", "label": "Tritan Severity", "type": "number", "group": "Accessibility", "default": 0, "validation": { "min": 0, "max": 1, "step": 0.1 } },
    { "key": "styles.comments", "label": "Comment Style", "type": "select", "group": "Styles", "default": "NONE", "options": [{ "value": "NONE", "label": "None" }, { "value": "italic", "label": "Italic" }, { "value": "bold", "label": "Bold" }, { "value": "bold,italic", "label": "Bold + Italic" }] },
    { "key": "styles.functions", "label": "Function Style", "type": "select", "group": "Styles", "default": "NONE", "options": [{ "value": "NONE", "label": "None" }, { "value": "italic", "label": "Italic" }, { "value": "bold", "label": "Bold" }, { "value": "bold,italic", "label": "Bold + Italic" }] },
    { "key": "inverse.match_paren", "label": "Inverse MatchParen", "type": "boolean", "group": "Styles", "default": false },
    { "key": "inverse.visual", "label": "Inverse Visual Selection", "type": "boolean", "group": "Styles", "default": false },
    { "key": "inverse.search", "label": "Inverse Search", "type": "boolean", "group": "Styles", "default": false },
    { "key": "modules", "label": "Module Toggles", "type": "lua", "group": "Integrations", "default": "{}", "expectedReturnType": "table" },
    { "key": "groups", "label": "Group Overrides", "type": "lua", "group": "Advanced", "default": "{ all = {} }", "expectedReturnType": "table" }
  ],
  "functions": [{ "name": "apply", "description": "Apply a Nightfox variant.", "params": [{ "name": "variant", "type": "string", "optional": true, "description": "Variant name; defaults to carbonfox." }], "returns": "void", "luaCall": "vim.cmd('colorscheme ' .. ($params.variant or 'carbonfox'))" }],
  "exCommands": [],
  "events": []
}
